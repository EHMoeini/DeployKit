name: {{ app_name }}

services:
{% for service in app_services %}
  {{ service.name }}:
    image: {{ service.image }}
    container_name: {{ app_name }}_{{ service.name }}
    restart: unless-stopped
{% if service.command is defined and service.command %}
    command: {{ service.command | to_json }}
{% endif %}
    networks:
      - internal
{% if service.expose_public | default(false) %}
      - {{ traefik_network }}
{% endif %}
{% if service.env is defined and service.env %}
    environment:
{% for key, value in service.env.items() %}
      {{ key }}: {{ (value | string) | to_json }}
{% endfor %}
{% endif %}
{% if service.volumes is defined and service.volumes %}
    volumes:
{% for vol in service.volumes %}
      - {{ vol | to_json }}
{% endfor %}
{% endif %}
{% if service.depends_on is defined and service.depends_on %}
    depends_on:
{% for dep in service.depends_on %}
      - {{ dep }}
{% endfor %}
{% endif %}
{% if service.expose_public | default(false) %}
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network={{ traefik_network }}"
      - "traefik.http.routers.{{ app_name }}-{{ service.name }}.rule=Host(`{{ service.domain }}`)"
      - "traefik.http.routers.{{ app_name }}-{{ service.name }}.entrypoints=websecure"
      - "traefik.http.routers.{{ app_name }}-{{ service.name }}.tls=true"
      - "traefik.http.routers.{{ app_name }}-{{ service.name }}.tls.certresolver=letsencrypt"
      - "traefik.http.services.{{ app_name }}-{{ service.name }}.loadbalancer.server.port={{ service.port }}"
{% endif %}

{% endfor %}
networks:
  internal:
    driver: bridge
  {{ traefik_network }}:
    external: true
{% if app_named_volumes is defined and app_named_volumes | length > 0 %}

volumes:
{% for vol_name in app_named_volumes %}
  {{ vol_name }}:
{% endfor %}
{% endif %}
