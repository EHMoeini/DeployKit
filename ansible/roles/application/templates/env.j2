NODE_ENV=production
PROJECT_NAME={{ project_name }}
PORT=3000
DOMAIN={{ domain }}
ACME_EMAIL={{ acme_email | default('admin@' ~ domain) }}
IMAGE_TAG={{ app_image_tag }}
GHCR_OWNER={{ ghcr_owner }}
GHCR_REPO={{ ghcr_repo }}
API_BASE_URL=/api/v1

BACKEND_REPLICAS={{ backend_replicas }}
FRONTEND_REPLICAS={{ frontend_replicas }}

DB_HOST={{ project_name }}_postgres
DB_PORT=5432
DB_NAME={{ db_name }}
DB_USER={{ db_user }}
DB_PASSWORD={{ db_password }}
DB_POOL_MAX={{ db_pool_max }}

JWT_SECRET={{ jwt_secret }}
REFRESH_TOKEN_SECRET={{ refresh_token_secret }}
CSRF_SECRET={{ csrf_secret }}
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7

SHARED_STORAGE_PATH=/srv/portal/uploads
MAX_FILE_SIZE_MB=5
